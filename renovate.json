{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prConcurrentLimit": 5,
  "regexManagers": [
    {
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "flutter-version:\\s*'?(?<currentValue>.+?)'?[\\s]*"
      ],
      "depNameTemplate": "flutter/flutter",
      "datasourceTemplate": "github-releases"
    }
  ]
}
